#version 450
layout(local_size_x = 256) in;
layout(set = 0, binding = 0, std430) readonly buffer Source { uint words[]; } src;
layout(set = 0, binding = 1, std430) buffer Result { uint errors; } result;
layout(push_constant) uniform Params { uint base; uint count; } params;
void main() {
  uint i = gl_GlobalInvocationID.x;
  if (i < params.count && src.words[i] != ((i + params.base) ^ 0xA5C39E71u))
    atomicAdd(result.errors, 1u);
}
